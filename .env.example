# Backend Python (app/). Copy thành .env rồi điền giá trị.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=Train

# Phải giống hệt INTERNAL_API_KEY trong web/.env.local
INTERNAL_API_KEY=

# Gemini (Google AI Studio)
AI_API_KEY=
AI_MODEL_NAME=gemini-3.6-flash

# Chroma Cloud (bỏ trống để lưu vào thư mục chroma_db/)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=Train

# Tùy chọn
# MAX_UPLOAD_MB=16
# AI_CHAT_TIMEOUT=120
# AI_REVIEW_TIMEOUT=600
# HOST=127.0.0.1
# PORT=8501
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
