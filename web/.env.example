# Frontend Next.js (web/). Copy thành .env.local rồi điền giá trị.

# Cùng database với backend Python
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=Train

PYTHON_API_URL=http://localhost:8501

# Phải giống hệt INTERNAL_API_KEY trong .env ở thư mục gốc
INTERNAL_API_KEY=

# Khóa ký phiên đăng nhập, ít nhất 32 ký tự
AUTH_SECRET=
